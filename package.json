{
  "name": "context-engineering-template",
  "version": "3.0.0",
  "description": "Advanced Context Engineering Template for Claude Code - Monorepo Edition",
  "private": true,
  "workspaces": [
    "packages/@claude-code/*",
    "cli"
  ],
  "scripts": {
    "init": "node cli/claude-init.js",
    "validate": "npm run validate --workspaces",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "benchmark": "node scripts/benchmark.js",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/node_modules coverage",
    "setup": "npm install && npm run build"
  },
  "keywords": [
    "claude-code",
    "ai-development",
    "context-engineering",
    "template-system",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1rtisan-LAB/context-engineering-template.git"
  },
  "devDependencies": {
    "@types/jest": "^29.5.15",
    "jest": "^30.0.5",
    "lerna": "^8.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}